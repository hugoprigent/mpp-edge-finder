PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8787
DASHBOARD_PIN_CODES=1706,0000
DASHBOARD_SESSION_SECRET=change-me-long-random-string

# MPP
MPP_CHAMPIONSHIP_ID=8
MPP_YEAR=2026
MPP_LOCAL_UTC_OFFSET_HOURS=2
MPP_PROFILE_DIR=./data/mpp-chrome-profile
MPP_HEADLESS=true
MPP_AUTO_SCRAPE=true
MPP_POLL_MINUTES=10
MPP_FAST_POLL_MINUTES=2
MPP_AUTO_PLAY=false
MPP_AUTO_PLAY_DRY_RUN=true
MPP_AUTO_PLAY_LEAD_SECONDS=60
MPP_AUTO_PLAY_WINDOW_SECONDS=45

# Strategy: chase = remonter au classement avec plus de leverage, ev = espérance pure.
MPP_STRATEGY_MODE=chase
MPP_CHASE_LEVERAGE_WEIGHT=0.35
MPP_CHASE_POSITIVE_CROWD_EDGE_WEIGHT=0.25
MPP_CHASE_NEGATIVE_CROWD_EDGE_WEIGHT=0.18
MPP_CHASE_LOTTERY_PENALTY_WEIGHT=0.8
MPP_CHASE_MIN_USEFUL_PROBABILITY=0.08
MPP_CHASE_SCORE_BONUS_WEIGHT=0.25

# Polymarket public/free
POLYMARKET_LEAGUE_SLUG=fwc
POLYMARKET_POLL_MINUTES=5

# Optional free Telegram bot notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_LEAD_MINUTES=10

# Optional free no-account push notifications.
# Pick a long random topic and subscribe to it in the ntfy mobile app/web app.
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
